tests/data/nist/*.dat -text
examples/*.csv -text
# Files whose bytes the environment manifest hashes (engine file digest, uv.lock digest) are checked out
# with LF on every platform, so identical repository content gives identical digests (EXP-006 part D).
*.py text eol=lf
uv.lock text eol=lf
# AXBENCH corpus files are hashed in MANIFEST.json and SEAL.json: keep their bytes identical on every platform.
data/axbench/**/*.jsonl -text
data/axbench/**/*.json -text
data/axbench/**/*.csv -text
# Experiment evidence whose bytes are pinned by SHA-256 (comparator outputs, run records, hash ledgers):
# keep the committed LF bytes on every platform. Original evidence is never rewritten (EXP-010 rev. 1).
docs/evidence/experiments/**/*.jsonl -text
docs/evidence/experiments/**/*.json -text
docs/evidence/experiments/**/*.sha256 -text
docs/evidence/experiments/**/*.txt -text
docs/evidence/experiments/**/*.log -text
docs/evidence/experiments/**/*.sh -text
