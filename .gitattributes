tests/data/nist/*.dat -text
examples/*.csv -text
# Files whose bytes the environment manifest hashes (engine file digest, uv.lock digest) are checked out
# with LF on every platform, so identical repository content gives identical digests (EXP-006 part D).
*.py text eol=lf
uv.lock text eol=lf
# AXBENCH corpus files are hashed in MANIFEST.json and SEAL.json: keep their bytes identical on every platform.
data/axbench/**/*.jsonl -text
data/axbench/**/*.json -text
data/axbench/**/*.csv -text
# AXBENCH-TR files are hashed in MANIFEST.json, ACQUISITION.json and the registry manifest: keep their bytes identical on every platform.
data/axbench-tr/**/*.jsonl -text
data/axbench-tr/**/*.json -text
data/axbench-tr/**/*.csv -text

# EXP-TR02 preflight evidence logs: raw bytes are hashed in the evidence index; keep them identical on every platform.
docs/evidence/experiments/EXP-TR02-feasibility-smoke/preflight/**/*.log -text
docs/evidence/experiments/EXP-TR02-feasibility-smoke/preflight/**/*.txt -text
docs/evidence/experiments/EXP-TR02-feasibility-smoke/preflight/**/*.json -text
